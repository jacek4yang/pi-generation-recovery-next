{
  "name": "pi-generation-recovery-next",
  "version": "0.1.0",
  "description": "Experimental provider-neutral generation-interruption recovery for Pi with narrowly scoped provider replay adapters.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "private": true,
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "tsx --test test/*.test.ts",
    "ci": "npm run check:pi && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "package-smoke": "node scripts/package-smoke.mjs",
    "smoke:pi": "node scripts/pi-load-smoke.mjs",
    "check:pi": "node scripts/check-pi-version.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {}
}
